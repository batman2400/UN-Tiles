# UN Tiles — Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

GEMINI_EMBED_API_KEY=your-gemini-embed-api-key
GEMINI_VISION_API_KEY=your-gemini-vision-api-key

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
